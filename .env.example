# Local development only. Copy to backend/.env. Do not commit the copy.
# These values are placeholders. They are not a merchant, courier, or production database.

# APP_ENV=production makes the owner session cookie Secure.
# Leave this as development for local HTTP. Do not put an owner password in this file.
APP_ENV=development

# Local Docker Compose database from the repository root.
# postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE
DATABASE_URL=postgresql+psycopg://autonovent:autonovent_dev_only@127.0.0.1:5432/autonovent

# Comma-separated frontend origins. Do not use *.
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# The public enquiry form is still configured separately in js/enquiry.js.
# Leave ENQUIRY_EMAIL in that file empty until a contact address is confirmed.

# ShipLogic sandbox only. Do not put a production token here.
# Register at https://sandbox.shiplogic.com/register, verify the email, then
# create a key under Integrations > API Keys. Paste it only into backend/.env.
# The documented sandbox API host is https://api.shiplogic.com. The token, not a
# second host, selects the sandbox. Live mode is not supported.
SHIPLOGIC_MODE=sandbox
SHIPLOGIC_API_TOKEN=
SHIPLOGIC_SANDBOX_BASE_URL=https://api.shiplogic.com
SHIPLOGIC_TIMEOUT_SECONDS=20

# Simulated checkout is off unless this is true and APP_ENV=development.
# APP_ENV=production refuses to start if this flag is true.
# The rates below are test amounts in cents. They are not ShipLogic prices.
# Leave the flag false here. Enable it only in the uncommitted backend/.env.
CHECKOUT_SIMULATION_ENABLED=true
CHECKOUT_SIMULATION_RATES=
CHECKOUT_SIMULATION_REGION_EXTRAS=
# Development-only test price in cents. It is not written to products.unit_price_cents.
# Leave empty unless APP_ENV=development and CHECKOUT_SIMULATION_ENABLED=true.
CHECKOUT_SIMULATION_DEMO_UNIT_PRICE_CENTS=

# capture stores mail in the API process and does not open a network connection.
# smtp sends to the host below. Local Mailpit listens on 127.0.0.1:1025 and shows mail at http://127.0.0.1:8025.
# resend uses the Resend API. Put the key only in backend/.env.
EMAIL_TRANSPORT=capture
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=Autonovent <orders@localhost>
RESEND_API_KEY=
EMAIL_LOGO_URL=
EMAIL_MAX_ATTEMPTS=5

# Address suggestions. Leave ADDRESS_PROVIDER empty to keep manual entry.
# google uses Places API (New) on the server. Restrict the key to this server's IP.
# Do not put the key in frontend JavaScript. Do not commit backend/.env.
ADDRESS_PROVIDER=
GOOGLE_PLACES_API_KEY=

# Checkout provider. Leave both empty while CHECKOUT_SIMULATION_ENABLED=true.
# To use PayFast sandbox payments, set all four of these together:
# CHECKOUT_SIMULATION_ENABLED=false
# COURIER_PROVIDER=shiplogic
# PAYMENT_PROVIDER=payfast
# PAYFAST_MODE=sandbox
# APP_ENV must stay development. Production refuses this pair. Live PayFast is rejected.
COURIER_PROVIDER=
PAYMENT_PROVIDER=

# PayFast sandbox only. Create the merchant at https://sandbox.payfast.co.za/.
# Copy the sandbox Merchant ID, Merchant Key, and Salt Passphrase into backend/.env.
# Leave PAYFAST_PASSPHRASE empty only when the sandbox account has no salt passphrase.
# PAYFAST_NOTIFY_URL must be public https and must reach only POST /api/v1/payments/payfast/itn.
# Do not put live merchant details here. Do not commit backend/.env.
PAYFAST_MODE=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=
PAYFAST_RETURN_URL=http://127.0.0.1:8765/checkout.html?payment=return
PAYFAST_CANCEL_URL=http://127.0.0.1:8765/checkout.html?payment=cancel
# Set this only while an https tunnel forwards PayFast to this machine.
# Cloudflare Tunnel uses CF-Connecting-IP. Leave empty until that tunnel is running.
PAYFAST_FORWARDED_IP_HEADER=

# Rhino Canopies warehouse collection address. Leave empty until the street
# address is confirmed. Do not invent these values.
COLLECTION_COMPANY=
COLLECTION_STREET_ADDRESS=
COLLECTION_LOCAL_AREA=
COLLECTION_CITY=
COLLECTION_ZONE=
COLLECTION_POSTAL_CODE=

# Confirmed packed parcel. The product unit size is not a packed parcel.
# Leave empty until packed length, width, height, and weight are confirmed.
PACKED_PARCEL_DESCRIPTION=
PACKED_PARCEL_LENGTH_MM=
PACKED_PARCEL_WIDTH_MM=
PACKED_PARCEL_HEIGHT_MM=
PACKED_PARCEL_WEIGHT_GRAMS=

# Optional PDF specification sheet per product. Files stay on the server, outside the website directory.
# Production uses /var/lib/omniprod/product-specifications. The default below is for local development.
PRODUCT_SPECIFICATION_DIR=var/product-specifications
PRODUCT_SPECIFICATION_MAX_BYTES=26214400

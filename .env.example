# Local development only. Copy to backend/.env. Do not commit the copy.
# These values are placeholders. They are not a merchant, courier, or production database.

# APP_ENV=production makes the owner session cookie Secure.
# Leave this as development for local HTTP. Do not put an owner password in this file.
APP_ENV=development

# Local Docker Compose database from the repository root.
# postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE
DATABASE_URL=postgresql+psycopg://autonovent:autonovent_dev_only@127.0.0.1:5432/autonovent

# Comma-separated frontend origins. Do not use *.
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# The public enquiry form is still configured separately in js/enquiry.js.
# Leave ENQUIRY_EMAIL in that file empty until a contact address is confirmed.

# Bob Go sandbox only. Do not put a production token here.
# Create a sandbox account at https://sandbox.bobgo.co.za/ and copy its API token
# into backend/.env. Leave this example value empty.
BOBGO_BASE_URL=https://api.sandbox.bobgo.co.za/v2
BOBGO_API_TOKEN=
BOBGO_TIMEOUT_SECONDS=20
